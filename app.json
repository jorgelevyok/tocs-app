{
  "expo": {
    "name": "TOCs",
    "slug": "tocs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/light.png",
    "scheme": "tocsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jorgelevy.tocs"
    },
    "android": {
      "package": "com.jorgelevy.tocs",
      "adaptiveIcon": {
        "backgroundColor": "#006B5B",
        "foregroundImage": "./assets/images/logo/light.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/light.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F8F5",
          "image": "./assets/images/logo/light.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TOCs usa una foto de la galería para la tarjeta o para un registro.",
          "cameraPermission": "TOCs usa la cámara para la foto de la tarjeta.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TOCs graba una nota de voz opcional cuando registrás un TOC.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5a5cc11a-4dae-4be8-be45-7ba8a88d11bd"
      }
    }
  }
}
