{
  "expo": {
    "name": "TOCs",
    "slug": "tocs-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tocs-logo.png",
    "scheme": "tocsapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.jorgelevy.tocs"
    },
    "android": {
      "package": "com.jorgelevy.tocs",
      "adaptiveIcon": {
        "backgroundColor": "#006B5B",
        "foregroundImage": "./assets/images/tocs-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tocs-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F8F5",
          "image": "./assets/images/tocs-logo.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TOCs usa una foto de la galería para la tarjeta o para un registro.",
          "cameraPermission": "TOCs usa la cámara para la foto de la tarjeta.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "TOCs graba una nota de voz opcional cuando registrás un TOC.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
